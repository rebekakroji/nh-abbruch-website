# Optional: Endpunkt eines Formular-Dienstes, z. B. Formspree.
# Ohne diesen Wert öffnet das Kontaktformular das E-Mail-Programm des Besuchers (mailto:).
# Achtung: Diese Variable landet im öffentlichen Frontend-Code. Verwenden Sie hier NIEMALS einen geheimen API-Schlüssel,
# sondern nur die öffentliche Formular-URL.
VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Optional: Google-Analytics-4-Measurement-ID ("G-XXXXXXXXXX" aus dem GA4-Property).
# Wird erst geladen, nachdem ein Besucher im Cookie-Banner der Statistik-Kategorie zugestimmt hat
# (Google Consent Mode v2, siehe src/consent/). Ohne diesen Wert bleibt GA4 deaktiviert.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google-Ads-Tag-ID ("AW-XXXXXXXXX" aus dem Google-Ads-Konto, Tools und Einstellungen →
# Conversion-Tracking → Conversions → Tag-Setup, oder "Google Tag" im Konto). Nutzt dasselbe
# gtag.js-Skript wie GA4 und wird erst geladen, nachdem ein Besucher der Marketing-Kategorie
# zugestimmt hat. Ohne diesen Wert bleibt das Google-Ads-Tag deaktiviert. Es wird keine
# Conversion-Aktion eingerichtet – dafür zusätzlich eine Conversion-ID/-Label aus Google Ads nötig.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
